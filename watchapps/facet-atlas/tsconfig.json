{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "typeRoots": ["./tools/dev/node_modules/@types"],
    "skipLibCheck": true
  },
  "include": ["types/*.d.ts", "src/pkjs/**/*.js", "tools/*.js", "test/js/*.js"]
}
